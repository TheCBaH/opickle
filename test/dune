; Per-module inline expect tests for the opickle library.

(library
 (name opickle_tests)
 (libraries opickle bytesrw)
 (inline_tests
  (modes best js))
 (preprocess
  (pps ppx_expect)))

(env
 (_
  (inline_tests enabled)
  (js_of_ocaml
   (runtest_alias runtest-js))))

(rule
 (target conformance_vectors.ml)
 (deps conformance_vectors.py)
 (action
  (with-stdout-to
   %{target}
   (run python3 %{dep:conformance_vectors.py}))))

(cram
 (deps %{bin:pickle_dump} genpickle.py dump_fixtures.py))
